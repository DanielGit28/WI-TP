# Copy this file to .env and fill in real values. Never commit .env itself.

# Pooled Neon connection string (Dashboard -> Connection Details -> Pooled connection)
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

PORT=8080

# Neon requires SSL, so leave this as true for deployed/Neon use.
# Set to false only if pointing at a local Postgres without SSL.
DB_SSL=true

# GitHub OAuth App (github.com/settings/developers -> New OAuth App).
# Authorization callback URL must be {APP_BASE_URL}/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-app-client-secret

# Generate any random string; used to sign session JWTs.
JWT_SECRET=replace-with-a-random-secret

# Encrypts stored GitHub OAuth tokens at rest (AES-256-GCM). Must be a
# 64-character hex string (32 bytes) — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# This app's own public URL — used to build the OAuth callback URL and the
# webhook URL registered on repos you connect. For local dev this needs to
# be a tunnel (ngrok/etc), since GitHub can't reach localhost directly.
APP_BASE_URL=http://localhost:8080

# Where the frontend lives. Optional locally (the OAuth callback returns
# the token as JSON if unset); once a frontend exists, also restricts CORS
# to this origin instead of allowing any.
FRONTEND_URL=
